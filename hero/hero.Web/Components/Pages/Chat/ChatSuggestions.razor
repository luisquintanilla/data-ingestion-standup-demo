@using Standup

<div class="page-width suggestions">
    <button class="btn-subtle" disabled="@Disabled" @onclick="@AddSuggestionAsync">
        @DemoConfiguration.Question
    </button>
</div>

@code {
    [Parameter]
    public EventCallback<ChatMessage> OnSelected { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task AddSuggestionAsync()
        => OnSelected.InvokeAsync(new(ChatRole.User, DemoConfiguration.Question));
}
